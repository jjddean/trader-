# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LoRA training artifacts
/tmp/
/lora-output/
/lora-output-kaggle-test/
/lora-colab-bundle/
/lora-colab-bundle.zip
/lora-runpod-bundle/
/lora-runpod-bundle.zip
/lora-dataset/.tariff-codes.json
/.runpod-lora-state.json
.kaggle-wheels/
.kaggle-dataset-staging/
.kaggle-wheels-staging/
.kaggle-kernel-debug*/
.kaggle-pull-test/
scripts/lora/autotrain.config.yaml

# python
__pycache__/
*.pyc

# wrangler (cloudagent local dev/build cache)
cloudagent/.wrangler/
cloudagent/.xdg/

# one-off working files (lint dumps, codemod scripts, Convex table exports)
/eslint_report.*
/build.log
/snapshot.zip
/convex-export.json
/diverged_numstat.csv
*/documents.jsonl
*/generated_schema.jsonl

/lora-runpod-worker-json-bundle/
/lora-runpod-worker-json-bundle.zip

# playwright artifacts
/playwright-report/
/test-results/

# secrets — never commit any .env variant
.env*
.env.sentry-build-plugin

# generated CDS XML dumps from ad-hoc runs (the frozen evidence lives in
# docs/hmrc/ACTIVE/tdr/evidence/ per AGENT-SPEC §8, and stays tracked)
/test-evidence/mcp-test*.xml

# generated UK Sanctions List snapshots (~12.5k designations, several MB each).
# Rebuilt on demand by `npm run export-controls:refresh-sanctions`; the
# authoritative copy lives in R2, pointed at by the sanctions_list dataset row.
/data/export-controls/sanctions-*.json
