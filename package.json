{
  "name": "freightcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:h1": "node --test --import tsx \"tests/h1/*.test.ts\"",
    "test:tdr-dry-run": "node scripts/tdr-dry-run.mjs",
    "test:tdr": "npm run test:h1 && npm run test:tdr-dry-run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "lora:bootstrap": "python scripts/lora/bootstrap.py",
    "lora:check": "python scripts/lora/check_hf_token.py",
    "lora:validate": "python scripts/lora/validate_dataset.py",
    "lora:prepare": "node generate-training-data.mjs --rows 10000 --out ./lora-dataset && python scripts/lora/validate_dataset.py && python scripts/lora/convert_dataset.py",
    "lora:install": "python scripts/lora/pipeline.py install",
    "lora:train": "python scripts/lora/pipeline.py train",
    "lora:wait": "python scripts/lora/pipeline.py wait",
    "lora:download": "python scripts/lora/pipeline.py download",
    "lora:status": "python scripts/lora/pipeline.py status",
    "lora:kaggle": "python scripts/lora/kaggle_train.py",
    "lora:tinker:models": "python scripts/lora/train_tinker.py --list-models",
    "lora:tinker": "python scripts/lora/train_tinker.py",
    "lora:tinker:smoke": "python scripts/lora/train_tinker.py --smoke 20",
    "lora:colab": "python scripts/lora/colab_open.py",
    "lora:colab:bundle": "node scripts/lora/run.mjs colab",
    "lora:deploy": "node scripts/lora/run.mjs deploy",
    "lora:all": "python scripts/lora/pipeline.py train && python scripts/lora/pipeline.py wait && npm run lora:deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/client-textract": "^3.1010.0",
    "@clerk/nextjs": "^7.5.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/stripe-js": "^8.9.0",
    "@tabler/icons-react": "^3.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.41.0",
    "fast-xml-parser": "^5.2.5",
    "geist": "^1.7.0",
    "groq-sdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.9",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "typesense": "^3.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
