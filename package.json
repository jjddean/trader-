{
  "name": "freightcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:security": "eslint src/lib/secrets-equal.ts src/lib/api-rate-limiter.ts src/app/api/hmrc src/app/api/stripe src/app/api/ai/extract src/app/api/ai/classify src/app/api/ai/smart-upload src/app/api/ai/chat src/app/api/ai/gir-audit convex/http.ts convex/stripe_webhooks.ts convex/hmrc_internal.ts convex/subscriptions.ts convex/notifications.ts convex/documents.ts convex/client_portal.ts convex/clients.ts convex/lib/portal_document_policy.ts --max-warnings 0",
    "test:h1": "node --test --import tsx \"tests/h1/*.test.ts\"",
    "test:unit": "node --test --import tsx \"tests/!(*.integration).test.ts\"",
    "test:fo": "node --test --import tsx tests/h1/financial-obligations.test.ts && node scripts/check-financial-obligations.mjs",
    "test:tre": "node --test --import tsx \"tests/tre/*.test.ts\"",
    "test:cns": "node --test --import tsx \"tests/cns/*.test.ts\"",
    "test:tdr-dry-run": "node scripts/tdr-dry-run.mjs",
    "test:audit-smoke": "node scripts/smoke-audit-log-shape.mjs",
    "test:sanctions": "node --test --import tsx tests/export-controls/sanctions-screen.test.ts && node --test tests/export-controls/sanctions-list-parse.test.mjs",
    "test:tdr": "npm run test:h1 && npm run test:tre && npm run test:tdr-dry-run",
    "test:file-upload-s3": "node test-evidence/file-upload-s3-e2e.js",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:auth": "playwright test e2e/auth --project=chromium",
    "test:portal": "node --test --import tsx tests/portal-document-policy.test.ts && vitest run --config vitest.portal.config.mts",
    "export-controls:ingest-sanctions": "node scripts/export-controls/ingest-sanctions-list.mjs",
    "export-controls:upload-sanctions": "node scripts/export-controls/upload-sanctions-to-r2.mjs",
    "export-controls:refresh-sanctions": "node scripts/export-controls/refresh-sanctions.mjs",
    "lora:bootstrap": "python scripts/lora/bootstrap.py",
    "lora:check": "python scripts/lora/check_hf_token.py",
    "lora:validate": "python scripts/lora/validate_dataset.py",
    "lora:prepare:v2": "python scripts/lora/generate_reasoning_consistency_data.py --out lora-dataset-v2 && python scripts/lora/validate_dataset.py --strict --schema worker-json lora-dataset-v2/train.csv && python scripts/lora/validate_dataset.py --strict --schema worker-json lora-dataset-v2/eval.csv && python scripts/lora/validate_tariff_codes.py lora-dataset-v2/train.csv lora-dataset-v2/eval.csv && python scripts/lora/validate_hmrc_ai_training_standard.py lora-dataset-v2/train-v2.jsonl && python scripts/lora/validate_hmrc_ai_training_standard.py lora-dataset-v2/eval-v2.jsonl && python scripts/lora/validate_hmrc_grade_v2.py lora-dataset-v2/train.csv lora-dataset-v2/eval.csv && python scripts/lora/convert_dataset.py lora-dataset-v2/train.csv lora-dataset-v2/train-autotrain.csv && python scripts/lora/convert_dataset.py lora-dataset-v2/eval.csv lora-dataset-v2/eval-autotrain.csv",
    "lora:prepare:reasoning": "npm run lora:prepare:v2",
    "lora:install": "python scripts/lora/pipeline.py install",
    "lora:train": "python scripts/lora/pipeline.py train",
    "lora:wait": "python scripts/lora/pipeline.py wait",
    "lora:download": "python scripts/lora/pipeline.py download",
    "lora:status": "python scripts/lora/pipeline.py status",
    "lora:kaggle": "python scripts/lora/kaggle_train.py",
    "lora:tinker:models": "python scripts/lora/train_tinker.py --list-models",
    "lora:tinker": "python scripts/lora/train_tinker.py",
    "lora:tinker:smoke": "python scripts/lora/train_tinker.py --smoke 20",
    "lora:colab": "python scripts/lora/colab_open.py",
    "lora:colab:bundle": "node scripts/lora/run.mjs colab",
    "lora:runpod": "python scripts/lora/runpod/runpod_train.py all",
    "lora:runpod:prepare": "python scripts/lora/runpod/runpod_train.py prepare",
    "lora:runpod:launch": "python scripts/lora/runpod/runpod_train.py launch",
    "lora:runpod:download": "python scripts/lora/runpod/runpod_train.py download",
    "lora:deploy": "node scripts/lora/run.mjs deploy",
    "lora:all": "python scripts/lora/pipeline.py train && python scripts/lora/pipeline.py wait && npm run lora:deploy",
    "test:all": "npm run test:unit && npm run test:h1 && npm run test:tre && npm run test:cns && npm run test:portal && npm run test:export-controls && npm run test:tdr-dry-run",
    "test:export-controls": "node --test --import tsx \"tests/export-controls/*.test.ts\" && node --test \"tests/export-controls/*.test.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/client-textract": "^3.1010.0",
    "@clerk/nextjs": "^7.5.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/stripe-js": "^8.9.0",
    "@tabler/icons-react": "^3.39.0",
    "@types/pdfmake": "^0.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.41.0",
    "dedalus": "^0.4.0",
    "fast-xml-parser": "^5.2.5",
    "geist": "^1.7.0",
    "groq-sdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.27.0",
    "next": "^16.2.9",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "^8.1.2",
    "recharts": "^3.8.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "typesense": "^3.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "postcss": "8.5.23",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.24",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.55",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
